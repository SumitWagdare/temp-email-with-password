# NoTrace Environment Configuration (Public keyless APIs used by default)
# Primary Email Provider: mail.tm
NEXT_PUBLIC_MAILTM_API_URL=https://api.mail.tm

# Fallback Email Provider: 1secmail
NEXT_PUBLIC_1SECMAIL_API_URL=https://www.1secmail.com/api/v1/

# Default accent swatch: cyan (cyan, emerald, violet, amber, rose)
NEXT_PUBLIC_DEFAULT_ACCENT=cyan
